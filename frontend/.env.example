# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# Copy to .env.local for Next.js frontend or your client deployment
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Auth & Client (Publishable)
# 1. Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 2. Supabase Anon / Publishable Key (Safe for browser / client exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Auth Callback URL (configured in Supabase Dashboard -> Auth -> URL Configuration)
NEXT_PUBLIC_SUPABASE_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Optional Client Services
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
